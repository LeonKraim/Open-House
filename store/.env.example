# Copy this to `.env` and fill it in:
#
#   cp .env.example .env
#
# `docker compose` reads `.env` from this directory automatically, on every
# command -- including `down` and `logs`, which is why the values live here
# rather than being exported in front of `up`. Only `up` needs them, but
# compose refuses *any* command while a `${PB_ADMIN_PASSWORD:?}` is unset, and
# a person who cannot run `docker compose down` without re-typing their admin
# password has been given a Store they cannot switch off.
#
# This is the *admin* of the Store, not a publisher. It is the account that
# imports the schema once; publishers make their own accounts from Open House.
# Pick a long password: this account can see and edit everything.

PB_ADMIN_EMAIL=you@example.com
PB_ADMIN_PASSWORD=change-me-to-something-long
